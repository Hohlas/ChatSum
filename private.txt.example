# Конфигурация Telegram API
TELEGRAM_API_ID=ваш_api_id
TELEGRAM_API_HASH=ваш_api_hash
TELEGRAM_PHONE=+79001234567

# ID канала для публикации результатов (узнать через @username_to_id_bot)
TELEGRAM_GROUP_ID=-1002...

GOOGLE_API_KEY=AIzaS...
GOOGLE_API_KEY1=AIzaSy...
GOOGLE_API_KEY2=AIzaSy...
GOOGLE_API_KEY3=AIzaSy...
# Ключей может быть сколько угодно (GOOGLE_API_KEY4, KEY5, ... KEY25):
# push_github_secrets.sh заберёт все, бот ротирует их по кругу.

# Model settings live in MODEL_CONFIG.txt (MODEL, TEMPERATURE,
# REASONING_EFFORT, CHUNK_MAX_CHARS) — tracked in git, one push updates
# both VPS and Actions modes, no Secrets/Variables change needed.

