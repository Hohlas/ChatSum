# Ключи и Telegram. Только секреты — параметров модели здесь нет,
# они живут в MODEL_CONFIG.txt отдельно на провайдер
# (GEMINI_* / OPENROUTER_* / NVIDIA_* / OPENCODE_* / TOKENHARBOR_* + LLM_PROVIDER).

# Конфигурация Telegram API
TELEGRAM_API_ID=ваш_api_id
TELEGRAM_API_HASH=ваш_api_hash
TELEGRAM_PHONE=+79001234567

# ID канала для публикации результатов (узнать через @username_to_id_bot)
TELEGRAM_GROUP_ID=-1002...

GOOGLE_API_KEY=AIzaS...
GOOGLE_API_KEY1=AIzaSy...
GOOGLE_API_KEY2=AIzaSy...
GOOGLE_API_KEY3=AIzaSy...
# Ключей может быть сколько угодно (GOOGLE_API_KEY4, KEY5, ... KEY25):
# push_github_secrets.sh заберёт все, бот ротирует их по кругу.

# Ключ OpenRouter (https://openrouter.ai/keys) для OPENROUTER_MODEL.
# Дополнительные ключи — OPENROUTER_API_KEY1, KEY2, KEY3, ... (ротация по 429).
# OPENROUTER_API_KEY=sk-or-v1-...

# Ключ подписки OpenCode Go (https://opencode.ai/console) для OPENCODE_MODEL.
# Дополнительные ключи — OPENCODE_GO_API_KEY1, KEY2, KEY3, ... (ротация по 429).
# OPENCODE_GO_API_KEY=...

# Ключ NVIDIA (https://build.nvidia.com) для NVIDIA_MODEL.
# Дополнительные ключи — NVIDIA_API_KEY1, KEY2, KEY3, ... (ротация по 429).
# NVIDIA_API_KEY=nvapi-...

# Ключ Token Harbor (https://tokenharbor.ai) для TOKENHARBOR_MODEL.
# Дополнительные ключи — TOKENHARBOR_API_KEY1, KEY2, KEY3, ... : у бесплатного
# уровня свой недельный запас у каждого ключа, ротация по 429 продлевает
# работу (push_github_secrets.sh заберёт все, бот ротирует их по кругу).
# TOKENHARBOR_API_KEY=thk_live_...

# Model settings live in MODEL_CONFIG.txt (LLM_PROVIDER, *_MODEL,
# *_TEMPERATURE, *_REASONING_EFFORT, *_CHUNK_MAX_CHARS) — tracked in git,
# one push updates both VPS and Actions modes, no Secrets/Variables change needed.
